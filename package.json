{
  "name": "roshan-beats-pwa",
  "version": "1.0.0",
  "description": "Roshan Beats Progressive Web App",
  "type": "module",
  "scripts": {
    "build": "parcel build index.html --dist-dir dist --no-source-maps",
    "build:prod": "parcel build index.html --dist-dir dist --no-source-maps",
    "build:optimized": "npm run build:prod && npm run optimize-assets",
    "optimize-assets": "node scripts/optimize-assets.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint js/**/*.js --ext .js",
    "lint:fix": "eslint js/**/*.js --ext .js --fix",
    "security-audit": "npm audit --audit-level moderate",
    "type-check": "tsc --noEmit",
    "build:secure": "npm run lint && npm run test && npm run build:prod",
    "serve": "node server.js",
    "deploy": "npm run build:optimized && gh-pages -d dist"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@jest/globals": "^27.5.1",
    "@parcel/packager-raw-url": "^2.16.1",
    "@parcel/transformer-jsonld": "^2.16.1",
    "@parcel/transformer-webmanifest": "^2.16.1",
    "abortcontroller-polyfill": "^1.7.5",
    "compression-webpack-plugin": "^10.0.0",
    "core-js": "^3.36.0",
    "cors": "^2.8.5",
    "csso": "^5.0.5",
    "dompurify": "^3.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.0",
    "eslint-plugin-security": "^2.1.1",
    "express": "^4.18.2",
    "gh-pages": "^6.0.0",
    "helmet": "^7.1.0",
    "html-minifier-terser": "^7.2.0",
    "intersection-observer": "^0.12.2",
    "jest": "^25.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.2.0",
    "parcel": "^2.10.3",
    "puppeteer": "^24.30.0",
    "rate-limiter-flexible": "^2.4.2",
    "regenerator-runtime": "^0.14.1",
    "resize-observer-polyfill": "^1.5.1",
    "sharp": "^0.32.6",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4",
    "terser": "^5.24.0",
    "web-animations-js": "^2.3.2",
    "whatwg-fetch": "^3.6.20",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "preset": null,
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/device": "^7.0.2",
    "@capacitor/geolocation": "^7.1.5",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/push-notifications": "^7.0.3"
  }
}
